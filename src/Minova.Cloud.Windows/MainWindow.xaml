<Window x:Class="Minova.Cloud.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minova Cloud" Width="880" Height="700" MinWidth="720" MinHeight="620" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen" Icon="Assets/icon.png">
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Image Source="Assets/lockup.png" Width="160" Height="38" Stretch="Uniform"/><Border Width="1" Height="22" Background="#36424C" Margin="22,0"/><TextBlock Text="Cloud for Windows" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"/></StackPanel>
  <Grid x:Name="LoginPanel" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="YOUR PRIVATE CLOUD" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="A place for&#10;everything.&#10;Right here." FontSize="46" FontWeight="SemiBold" LineHeight="51" Margin="0,18,0,20"/><TextBlock Text="Your Minova files, inside File Explorer. Open, save, and move them just like any other folder." FontSize="16" Foreground="{StaticResource MutedBrush}" LineHeight="25"/><TextBlock Text="Online-only until you need them.&#10;Available offline when you choose." Margin="0,25,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" LineHeight="22"/></StackPanel>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="25" VerticalAlignment="Center"><StackPanel><TextBlock Text="Welcome to Minova." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Sign in with your existing Cloud account." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/><TextBlock Text="Username" Margin="0,0,0,7"/><TextBox x:Name="Username" AutomationProperties.Name="Minova username"/><TextBlock Text="Password" Margin="0,18,0,7"/><PasswordBox x:Name="Password" AutomationProperties.Name="Minova password" KeyDown="PasswordKeyDown"/><TextBlock x:Name="LoginError" Foreground="#FFAFAC" Margin="0,12,0,0"/><Button x:Name="SignInButton" Content="Connect this PC →" Background="{StaticResource AccentBrush}" Foreground="#061B22" FontWeight="SemiBold" Margin="0,12,0,0" Click="SignIn"/><TextBlock Text="Invited to Minova? Create your account using the invitation email first." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,20,0,0"/></StackPanel></Border>
  </Grid>
  <Grid x:Name="ConnectedPanel" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="Greeting" Text="Your Cloud." FontSize="34" FontWeight="SemiBold"/><TextBlock x:Name="AccountLabel" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="Open Cloud ↗" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OpenWeb"/></Grid>
   <Border Grid.Row="1" Margin="0,24,0,0" CornerRadius="12" Padding="24" BorderBrush="#2E626E" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11333D" Offset="0"/><GradientStop Color="#191627" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusTitle" Text="Connecting…" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Foreground="#B9CED5" Margin="0,9,0,0"/><TextBlock x:Name="FileCount" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,16,0,0"/></StackPanel><Image Grid.Column="1" Source="Assets/icon.png" Width="68" Height="68"/></Grid></Border>
   <StackPanel Grid.Row="2" Margin="0,20,0,0"><WrapPanel><Button Content="Open Minova folder" Background="{StaticResource AccentBrush}" Foreground="#061B22" FontWeight="SemiBold" Margin="0,0,12,0" Click="OpenFolder"/><Button x:Name="SyncButton" Content="Sync now" Margin="0,0,12,0" Click="SyncNow"/><Button x:Name="PauseButton" Content="Pause sync" Click="PauseSync"/></WrapPanel><TextBlock x:Name="FolderPath" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/><CheckBox x:Name="StartupBox" Content="Start Minova Cloud when I sign in to Windows" Click="StartupChanged"/><TextBlock Text="Right-click a file in Explorer to keep it on this device or free up space. Deletions sync to Cloud trash. Shared files and invitations are available in Open Cloud." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,12"/></StackPanel>
   <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><Button Content="Disconnect this PC" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="Disconnect"/></Grid><ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="#CDD5DF" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="MINOVA CLOUD" Foreground="#6E8390" FontSize="10"/><TextBlock x:Name="VersionLabel" Text="" Foreground="#6E8390" HorizontalAlignment="Right" FontSize="10"/></Grid>
 </Grid>
</Window>
